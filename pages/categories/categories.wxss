.categories-page {
  padding-bottom: 40rpx;
}

.category-tabs {
  width: 100%;
  white-space: nowrap;
}

.category-tab {
  display: inline-flex;
  align-items: center;
  margin-right: 18rpx;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #4e5969;
  font-size: 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(31, 35, 41, 0.06);
}

.category-tab.active {
  background: #1f7aeb;
  color: #ffffff;
}

.category-count {
  min-width: 34rpx;
  height: 34rpx;
  margin-left: 12rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.24);
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 28rpx;
}

.photo-card {
  overflow: hidden;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(31, 35, 41, 0.08);
}

.photo-image {
  display: block;
  width: 100%;
  height: 260rpx;
  background: #edf0f5;
}

.photo-info {
  padding: 18rpx;
}

.photo-desc {
  overflow: hidden;
  color: #1f2329;
  font-size: 26rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.photographer-link {
  margin-top: 10rpx;
  color: #1f7aeb;
  font-size: 24rpx;
}
