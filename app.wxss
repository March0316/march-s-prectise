page {
  background: #f7f8fa;
  color: #1f2329;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
}

.section-title {
  margin: 16rpx 0 24rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.empty {
  margin-top: 160rpx;
  color: #8f959e;
  font-size: 28rpx;
  text-align: center;
}
